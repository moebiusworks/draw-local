{
  "name": "draw-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch src/server.ts",
    "build": "vite build",
    "start": "tsx src/server.ts",
    "mcp": "tsx src/mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build",
    "notices": "node scripts/generate-notices.mjs",
    "postinstall": "node scripts/copy-excalidraw-assets.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
